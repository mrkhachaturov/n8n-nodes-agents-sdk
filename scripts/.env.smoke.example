# Copy to .env.smoke and fill. Source before running sidecar-smoke.sh.
# .env.smoke is git-ignored.
SIDECAR_URL=http://entra-auth-sidecar:5000
BLUEPRINT_APP_ID=
TEST_AGENT_UPN=                          # optional: an agentic user UPN
TEST_DELEGATED_USER_TOKEN=               # optional: delegated user bearer for the
                                         # Blueprint's access_agent scope (OBO starter).
                                         # Acquire via `az account get-access-token
                                         # --scope "api://<blueprintAppId>/access_agent"`
                                         # or MSAL device-code flow. Exercises OBO test 4.
TEST_INBOUND_ACTIVITY_BEARER=            # optional: a real inbound bearer captured from
                                         # a Teams webhook hitting your trigger.
                                         # Exercises /Validate test 5a (success path).
TEST_BAD_INBOUND_BEARER=                 # optional override. Defaults to a literal
                                         # malformed JWT so test 5b (negative /Validate,
                                         # spec §9.1) always runs without extra setup.
